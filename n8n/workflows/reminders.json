{
  "id": "novacorpReminders",
  "name": "NovaCorp - Relances 24 h et alertes RH 48 h",
  "active": false,
  "nodes": [
    {
      "id": "Manuel",
      "name": "Manuel",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "parameters": {},
      "position": [
        0,
        0
      ]
    },
    {
      "id": "Toutes les minutes",
      "name": "Toutes les minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "position": [
        0,
        200
      ]
    },
    {
      "id": "Configuration",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "request_id",
              "name": "request_id",
              "value": "",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "position": [
        220,
        0
      ]
    },
    {
      "id": "Verifier les echeances",
      "name": "Verifier les echeances",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://supabase_kong_NovaCorp:8000/rest/v1/rpc/queue_due_hr_reminders",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {p_request_id:$json.request_id || null} }}",
        "options": {
          "timeout": 15000
        }
      },
      "position": [
        440,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "novacorpSupabaseLocal",
          "name": "NovaCorp - Supabase local"
        }
      }
    }
  ],
  "connections": {
    "Manuel": {
      "main": [
        [
          {
            "node": "Configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Toutes les minutes": {
      "main": [
        [
          {
            "node": "Configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configuration": {
      "main": [
        [
          {
            "node": "Verifier les echeances",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Paris",
    "executionTimeout": 240,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none"
  },
  "pinData": {}
}
