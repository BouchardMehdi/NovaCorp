{
  "name": "novacorp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "supabase:start": "supabase start --network-id novacorp_default",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "auth:seed": "node --env-file=.env.local scripts/seed-users.mjs",
    "local:env": "node scripts/local-env.mjs",
    "mail:start": "docker compose up -d mailhog",
    "mail:stop": "docker compose stop mailhog",
    "db:migrate": "supabase migration up --local",
    "db:test": "supabase test db --network-id novacorp_default",
    "db:lint": "supabase db lint --local --level warning",
    "db:types": "node scripts/generate-database-types.mjs",
    "business:seed": "node --env-file=.env.local scripts/seed-business-rules.mjs",
    "db:verify": "node scripts/verify-database.mjs",
    "n8n:env": "node scripts/n8n-env.mjs",
    "n8n:start": "npm run n8n:env && docker compose --profile automation up -d --wait n8n",
    "n8n:stop": "docker compose --profile automation stop n8n",
    "n8n:logs": "docker compose --profile automation logs --tail 100 n8n",
    "n8n:setup": "node scripts/n8n-setup.mjs",
    "n8n:verify": "node scripts/n8n-verify.mjs",
    "llm:start": "docker compose --profile automation up -d --wait ollama",
    "llm:pull": "docker compose --profile automation exec -T ollama ollama pull qwen3:1.7b",
    "llm:stop": "docker compose --profile automation stop ollama",
    "n8n:qualification:build": "node scripts/build-qualification-workflows.mjs",
    "n8n:qualification:install": "npm run n8n:qualification:build && node scripts/install-qualification-workflows.mjs",
    "n8n:qualification:start": "node scripts/start-qualification-workflows.mjs",
    "n8n:qualification:stop": "node scripts/stop-qualification-workflows.mjs",
    "n8n:qualification:test": "node --test tests/qualification.unit.mjs",
    "n8n:qualification:verify": "node --env-file=.env.local scripts/verify-qualification.mjs",
    "n8n:approvals:build": "node scripts/build-approval-workflows.mjs",
    "n8n:approvals:install": "npm run n8n:approvals:build && node scripts/install-approval-workflows.mjs",
    "n8n:approvals:start": "node scripts/start-approval-workflows.mjs",
    "n8n:approvals:stop": "node scripts/stop-approval-workflows.mjs",
    "n8n:approvals:verify": "node --env-file=.env.local scripts/verify-approvals.mjs",
    "n8n:reminders:build": "node scripts/build-reminder-workflow.mjs",
    "n8n:reminders:install": "npm run n8n:reminders:build && node scripts/install-reminder-workflow.mjs",
    "n8n:reminders:start": "node scripts/start-reminder-workflow.mjs",
    "n8n:reminders:stop": "node scripts/stop-reminder-workflow.mjs",
    "n8n:reminders:verify": "node --env-file=.env.local scripts/verify-reminders.mjs",
    "demo:seed": "node --env-file=.env.local scripts/seed-demo-data.mjs",
    "ngrok:env": "node scripts/ngrok.mjs env",
    "ngrok:start": "node scripts/ngrok.mjs start",
    "ngrok:stop": "node scripts/ngrok.mjs stop",
    "n8n:webhook:setup": "node scripts/setup-requests-webhook.mjs",
    "n8n:webhook:verify": "node scripts/verify-requests-webhook.mjs",
    "n8n:webhook:verify:public": "node scripts/verify-requests-webhook.mjs --public",
    "n8n:webhook:connect": "node scripts/connect-requests-webhook.mjs",
    "n8n:webhook:disconnect": "node scripts/connect-requests-webhook.mjs --disable",
    "n8n:webhook:verify:chain": "node scripts/verify-requests-webhook-chain.mjs",
    "n8n:digest:build": "node scripts/build-digest-workflows.mjs",
    "n8n:digest:install": "npm run n8n:digest:build && node scripts/manage-digest-workflows.mjs install",
    "n8n:digest:start": "node scripts/manage-digest-workflows.mjs start",
    "n8n:digest:stop": "node scripts/manage-digest-workflows.mjs stop",
    "n8n:digest:verify": "node --env-file=.env.local scripts/verify-digest.mjs",
    "n8n:onboarding:build": "node scripts/build-onboarding-workflow.mjs",
    "n8n:onboarding:install": "npm run n8n:onboarding:build && node scripts/manage-onboarding-workflow.mjs install",
    "n8n:onboarding:start": "node scripts/manage-onboarding-workflow.mjs start",
    "n8n:onboarding:stop": "node scripts/manage-onboarding-workflow.mjs stop",
    "n8n:onboarding:verify": "node --env-file=.env.local scripts/verify-onboarding.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "supabase": "2.120.0",
    "typescript": "6.0.3"
  }
}
