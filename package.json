{
  "name": "novacorp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "supabase:start": "supabase start --network-id novacorp_default",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "auth:seed": "node --env-file=.env.local scripts/seed-users.mjs",
    "local:env": "node scripts/local-env.mjs",
    "mail:start": "docker compose up -d mailhog",
    "mail:stop": "docker compose stop mailhog",
    "db:migrate": "supabase migration up --local",
    "db:test": "supabase test db --network-id novacorp_default",
    "db:lint": "supabase db lint --local --level warning",
    "db:types": "node scripts/generate-database-types.mjs",
    "business:seed": "node --env-file=.env.local scripts/seed-business-rules.mjs",
    "db:verify": "node scripts/verify-database.mjs",
    "n8n:env": "node scripts/n8n-env.mjs",
    "n8n:start": "npm run n8n:env && docker compose --profile automation up -d --wait n8n",
    "n8n:stop": "docker compose --profile automation stop n8n",
    "n8n:logs": "docker compose --profile automation logs --tail 100 n8n",
    "n8n:setup": "node scripts/n8n-setup.mjs",
    "n8n:verify": "node scripts/n8n-verify.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "supabase": "2.120.0",
    "typescript": "6.0.3"
  }
}
